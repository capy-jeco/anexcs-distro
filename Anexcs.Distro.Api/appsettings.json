{
  "ConnectionStrings": {
    "CentralDatabase": "Host=postgres;Port=5432;Database=anexcs_distro_central;Username=postgres;Password=postgres"
  },
  "TenantDatabase": {
    "Servers": {
      "primary": {
        "AdminConnectionString": "Host=postgres;Port=5432;Database=postgres;Username=postgres;Password=postgres",
        "AppConnectionString": "Host=postgres;Port=5432;Database=postgres;Username=anexcs_app;Password=<app-user-password>"
      }
    }
  },
  "Jwt": {
    "Issuer": "Anexcs.Distro",
    "Audience": "Anexcs.Distro.Client",
    "ExpiryMinutes": 60
  },
  "Tenancy": {
    "CentralHosts": [ "localhost", "central.distro.anexcs.com" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
